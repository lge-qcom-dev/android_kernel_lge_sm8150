# Display
CONFIG_FB_VIRTUAL=y

# Input - fingerprint
CONFIG_FINGERPRINT_GOODIX_GF3208=y

# Input - touchscreen
CONFIG_LGE_TOUCH_FW_PATH="touch/alpha"
CONFIG_LGE_TOUCH_LGSIC_SW42000=y
CONFIG_SAR_ATMF04_F37=y

# LGE
CONFIG_MACH_SM8150_ALPHA=y
CONFIG_MACH_SM8150_ALPHA_LAO_COM=y
CONFIG_LGE_QSDL_SUPPORT=y

# Thermal
CONFIG_THERMAL_EMULATION=y

# Vibrator
CONFIG_A2V=y
