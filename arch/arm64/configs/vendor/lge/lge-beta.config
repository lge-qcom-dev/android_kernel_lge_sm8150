# Display
CONFIG_FB_VIRTUAL=y

# Input - fingerprint
CONFIG_FINGERPRINT_GOODIX_GF3208=y

# Input - touchscreen
CONFIG_LGE_TOUCH_FW_PATH="touch/beta"
CONFIG_LGE_TOUCH_LGSIC_SW42000=y
CONFIG_LGE_TOUCH_SYNAPTICS_S3706=y
CONFIG_SAR_ATMF04_F37=y

# LGE
CONFIG_MACH_SM8150_BETA=y

# Power
CONFIG_SMB1390_CHARGE_PUMP=y

# TEE
# CONFIG_TRUSTONIC_TEE is not set

# Thermal
CONFIG_THERMAL_EMULATION=y
