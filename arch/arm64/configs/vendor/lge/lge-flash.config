# Dual screen
CONFIG_LGE_COVER_DISPLAY=y
CONFIG_LGE_USE_DD_SAR_RESET=y

# FPGA
CONFIG_FPGA=y
CONFIG_FPGA_MGR_ICE40_SPI_LGE=y
CONFIG_LATTICE_ICE40=y

# Input - fingerprint
CONFIG_FINGERPRINT_GOODIX_GF3208=y

# Input - touchscreen
CONFIG_LGE_TOUCH_FW_PATH="touch/flash"
CONFIG_LGE_TOUCH_MODULE_DETECT=y
CONFIG_LGE_TOUCH_MODULE_SW49106=m
CONFIG_LGE_TOUCH_MODULE_S3706=m
CONFIG_LGE_TOUCH_MODULE_FT3518=m
CONFIG_LGE_TOUCH_SYNAPTICS_S3707=y
CONFIG_SAR_ATMF04_F37=y

# LED
CONFIG_LEDS_LGE_EMOTIONAL=y
CONFIG_LEDS_LP5521_COVER=y

# LGE
CONFIG_MACH_SM8150_FLASH=y
CONFIG_MACH_SM8150_FLASH_LAO_COM=y
CONFIG_LGE_QSDL_SUPPORT=y
CONFIG_LGE_DUAL_QFUSE=y

# Vibrator
CONFIG_A2V=y
