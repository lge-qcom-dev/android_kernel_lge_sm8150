# cmdline
CONFIG_CMDLINE="earlycon=msm_geni_serial,0xa90000 keep_bootcon console=ttyMSM0,115200n8 loglevel=8"

# Display
CONFIG_LGE_DUAL_SCREEN=y

# Input - fingerprint
CONFIG_BBK_ET713=y

# Input - touchscreen
CONFIG_LGE_TOUCH_FW_PATH="touch/mh2lm"
CONFIG_LGE_TOUCH_MODULE_DETECT=y
CONFIG_LGE_TOUCH_SYNAPTICS_S3618=y
CONFIG_LGE_TOUCH_SYNAPTICS_S3706_MH2=y
CONFIG_SAR_ATMF04_12QFN=y

# LGE
CONFIG_MACH_SM8150_MH2LM=y
CONFIG_LGE_DUAL_QFUSE=y
CONFIG_LGE_QSDL_SUPPORT=y

# Sensors
CONFIG_SENSORS_TCS3407=y

# Vibrator
CONFIG_A2V=y
